[Unit]
Description=KODI Channels ASGI WebSocket server
After=network.target redis-server.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/www/sortan
EnvironmentFile=/etc/sortan.env
Environment=DJANGO_SETTINGS_MODULE=config.production
ExecStart=/var/www/sortan/venv/bin/uvicorn config.asgi:application --host 127.0.0.1 --port 8001 --proxy-headers --forwarded-allow-ips=127.0.0.1 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
